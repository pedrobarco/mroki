:80 {
	# Health endpoint for container healthchecks
	handle /health {
		respond 200
	}

	handle {
		root * /srv

		# Security response headers for the SPA. Applied to every response in
		# this block (index.html + assets); the /health handler above is left
		# untouched. See #197; values are kept consistent with the mroki-api
		# security-headers middleware (#187).
		header {
			# Stop MIME-sniffing away from the declared Content-Type.
			X-Content-Type-Options "nosniff"
			# Clickjacking defense (paired with CSP frame-ancestors below).
			X-Frame-Options "DENY"
			# Do not leak URLs via the Referer header.
			Referrer-Policy "no-referrer"
			# HSTS is emitted unconditionally: browsers ignore it over plain
			# HTTP and only honor it over HTTPS, so it assumes TLS termination
			# upstream (mroki does not terminate TLS itself).
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			# CSP for the built Vite SPA. The production bundle loads only
			# same-origin resources: module scripts (index-*.js, config.js)
			# under script-src and one stylesheet (index-*.css) under
			# style-src, with no inline <script>/<style>. 'unsafe-inline' is
			# required for style-src because Vue/reka-ui emit runtime inline
			# style attributes for positioning. connect-src is widened with the
			# deploy-time API origin ({$MROKI_APP_API_BASE_URL}) so fetch/XHR to
			# mroki-api is allowed. data: in img-src/font-src covers small
			# assets that Vite may inline as base64 (assetsInlineLimit).
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' {$MROKI_APP_API_BASE_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		}

		# Cache hashed assets (Vite generates fingerprinted filenames)
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		# SPA fallback — serve index.html for all non-file routes
		try_files {path} /index.html
		file_server
	}
}
