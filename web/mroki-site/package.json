{
  "name": "mroki-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "scripts": {
    "bundle:openapi": "node .vitepress/scripts/bundle-openapi.mjs",
    "dev": "pnpm bundle:openapi && vitepress dev",
    "build": "pnpm bundle:openapi && vitepress build",
    "preview": "vitepress preview",
    "lint": "eslint . --fix && prettier --check \"*.md\" \".vitepress/**/*.{ts,mjs}\"",
    "format": "prettier --write \"*.md\" \".vitepress/**/*.{ts,mjs}\""
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-openapi": "^0.2.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
